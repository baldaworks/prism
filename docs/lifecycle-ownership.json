{
  "version": 6,
  "lifecycle_ref": "prism/lifecycle",
  "manual_host_entrypoints": {
    "codex": "$prism:lifecycle",
    "claude": "/prism:lifecycle",
    "flat": "/prism-lifecycle"
  },
  "automated_host_entrypoints": {
    "codex": "$prism-callee:lifecycle",
    "claude": "/prism-callee:lifecycle",
    "flat": "/prism-callee-lifecycle"
  },
  "lifecycle_labels": [
    "prism",
    "human:approved"
  ],
  "impact_lens": {
    "design_heading": "## Prism Impact Lens",
    "columns": [
      "Dimension",
      "Rating",
      "Rationale / evidence",
      "Mitigation / verification"
    ],
    "dimensions": [
      "Product",
      "Process",
      "People",
      "Planet",
      "Prosperity"
    ],
    "ratings": [
      "positive",
      "negative",
      "mixed",
      "not-material",
      "unknown"
    ],
    "numeric_score": false,
    "requires_rationale": true,
    "material_ratings": [
      "negative",
      "mixed"
    ],
    "material_requires": "mitigation_or_residual_impact_disposition",
    "unknown_blocks_transition": "breakdown",
    "human_summary_order": [
      "Design summary",
      "Prism Impact Lens",
      "Task summary",
      "Approval request"
    ],
    "approval_scope": [
      "design",
      "tasks",
      "mitigations",
      "disclosed_residual_impacts"
    ],
    "open_story_migration": {
      "missing_or_invalid": "design",
      "clear_human_approval": true,
      "preserve_child_statuses": true,
      "reconcile_children_in": "breakdown"
    },
    "closed_story_migration": "unchanged"
  },
  "entry_resolution": {
    "explicit_story_id": "resume",
    "single_open_prism_story": "resume",
    "otherwise": "create",
    "new_story": {
      "labels": [
        "prism"
      ],
      "assignee": "prism/specify",
      "description": "raw_user_request"
    }
  },
  "story_phases": [
    {
      "phase": "specify",
      "assignee": "prism/specify",
      "aliases": [
        "prism:specify"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/specify.md",
        "public_ref": "prism/phases/specify",
        "internal_refs": [
          "prism/specify/loop",
          "prism/specify/questions",
          "prism/specify/extract",
          "prism/roles/interviewer",
          "prism/specify/gate"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "design"
    },
    {
      "phase": "design",
      "assignee": "prism/design",
      "aliases": [
        "prism:design"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/design.md",
        "public_ref": "prism/phases/design",
        "internal_refs": [
          "prism/design/flow",
          "prism/roles/explorer",
          "prism/roles/architect"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "breakdown"
    },
    {
      "phase": "breakdown",
      "assignee": "prism/breakdown",
      "aliases": [
        "prism:breakdown"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/breakdown.md",
        "public_ref": "prism/phases/breakdown",
        "internal_refs": [
          "prism/roles/breakdown"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "human"
    },
    {
      "phase": "human",
      "assignee": "prism/human",
      "aliases": [
        "prism:human"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/human.md",
        "public_ref": "prism/phases/human",
        "internal_refs": [
          "prism/human/prompt",
          "prism/human/intent",
          "prism/human/check"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "apply"
    },
    {
      "phase": "apply",
      "assignee": "prism/apply",
      "aliases": [
        "prism:apply"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/apply.md",
        "public_ref": "prism/phases/apply",
        "internal_refs": [
          "prism/apply/loop"
        ]
      },
      "requires_human_approval": true,
      "success_transition": "verify"
    },
    {
      "phase": "verify",
      "assignee": "prism/verify",
      "aliases": [
        "prism:verify"
      ],
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/verify.md",
        "public_ref": "prism/phases/verify",
        "internal_refs": [
          "prism/verify/review",
          "prism/roles/reviewer"
        ]
      },
      "requires_human_approval": true,
      "success_transition": "close",
      "bounce_transitions": {
        "implementation_gap": "apply",
        "breakdown_gap": "breakdown",
        "design_gap": "design",
        "requirements_gap": "specify"
      }
    }
  ],
  "task_states": [
    {
      "state": "implementation",
      "assignee": "prism/apply/implementer",
      "aliases": [
        "prism:apply:implementer"
      ],
      "success_transition": "review"
    },
    {
      "state": "review",
      "assignee": "prism/apply/reviewer",
      "aliases": [
        "prism:apply:reviewer"
      ],
      "success_transition": "close",
      "failure_transition": "implementation"
    }
  ]
}
