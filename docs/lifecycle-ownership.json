{
  "version": 11,
  "lifecycle_ref": "prism/lifecycle",
  "direct_callee_invocation": "callee agent run prism/lifecycle --message \"...\"",
  "manual_host_entrypoints": {
    "codex": "$prism:lifecycle",
    "claude": "/prism:lifecycle",
    "flat": "/prism-lifecycle"
  },
  "automated_host_entrypoints": {
    "codex": "$prism-callee:lifecycle",
    "claude": "/prism-callee:lifecycle",
    "flat": "/prism-callee-lifecycle"
  },
  "lifecycle_labels": [
    "prism",
    "human:approved",
    "phase:specify",
    "phase:design",
    "phase:breakdown",
    "phase:human",
    "phase:apply",
    "phase:verify"
  ],
  "phase_labels": [
    "phase:specify",
    "phase:design",
    "phase:breakdown",
    "phase:human",
    "phase:apply",
    "phase:verify"
  ],
  "advance_policy": {
    "pre_approval_phases": [
      "specify",
      "design",
      "breakdown"
    ],
    "mode": "continuous_through_human_request",
    "confirmation_between_phases": false
  },
  "human_gate": {
    "summary_order": [
      "Design summary",
      "Task summary",
      "Approval request"
    ],
    "approval_scope": [
      "design",
      "tasks"
    ],
    "classifier_decisions": [
      "APPROVE",
      "REFINE_DESIGN",
      "WITHHOLD"
    ],
    "refine_stop_marker": "PRISM_HUMAN_DECISION=REFINE_DESIGN",
    "decisions": {
      "approve": {
        "transition": "apply",
        "approval_label": "human:approved"
      },
      "refine_design": {
        "transition": "design",
        "clear_approval": true,
        "preserve_children": true
      },
      "withhold": {
        "transition": "human"
      }
    }
  },
  "entry_resolution": {
    "explicit_story_id": "resume",
    "single_open_prism_story": "resume",
    "otherwise": "create",
    "new_story": {
      "labels": [
        "prism",
        "phase:specify"
      ],
      "description": "raw_user_request"
    }
  },
  "story_phases": [
    {
      "phase": "specify",
      "label": "phase:specify",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/specify.md",
        "public_ref": "prism/phases/specify",
        "internal_refs": [
          "prism/specify/loop",
          "prism/specify/questions",
          "prism/specify/extract",
          "prism/roles/interviewer",
          "prism/specify/gate"
        ],
        "clarification_loop": {
          "ref": "prism/specify/loop",
          "kind": "Loop",
          "normalizer_ref": "prism/roles/interviewer",
          "gate_ref": "prism/specify/gate",
          "human_ref": "prism/specify/questions",
          "ready_transition": "exit",
          "clarification_transition": "repeat",
          "max_iterations": 5,
          "on_exhausted": "fail"
        }
      },
      "requires_human_approval": false,
      "success_transition": "design"
    },
    {
      "phase": "design",
      "label": "phase:design",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/design.md",
        "public_ref": "prism/phases/design",
        "internal_refs": [
          "prism/design/flow",
          "prism/roles/explorer",
          "prism/roles/architect"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "breakdown"
    },
    {
      "phase": "breakdown",
      "label": "phase:breakdown",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/breakdown.md",
        "public_ref": "prism/phases/breakdown",
        "internal_refs": [
          "prism/roles/breakdown"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "human"
    },
    {
      "phase": "human",
      "label": "phase:human",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/human.md",
        "public_ref": "prism/phases/human",
        "internal_refs": [
          "prism/human/prompt",
          "prism/human/intent",
          "prism/human/check"
        ]
      },
      "requires_human_approval": false,
      "success_transition": "apply",
      "decision_transitions": {
        "approve": "apply",
        "refine_design": "design",
        "withhold": "human"
      }
    },
    {
      "phase": "apply",
      "label": "phase:apply",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/apply.md",
        "public_ref": "prism/phases/apply",
        "internal_refs": [
          "prism/apply/loop"
        ]
      },
      "requires_human_approval": true,
      "success_transition": "verify"
    },
    {
      "phase": "verify",
      "label": "phase:verify",
      "executor": {
        "kind": "Sequential",
        "manual_phase_reference": "plugins/prism/skills/lifecycle/references/verify.md",
        "public_ref": "prism/phases/verify",
        "internal_refs": [
          "prism/verify/review",
          "prism/roles/reviewer"
        ]
      },
      "requires_human_approval": true,
      "success_transition": "close",
      "bounce_transitions": {
        "implementation_gap": "apply",
        "breakdown_gap": "breakdown",
        "design_gap": "design",
        "requirements_gap": "specify"
      }
    }
  ],
  "task_states": [
    {
      "state": "implementation",
      "assignee": "prism/apply/implementer",
      "aliases": [
        "prism:apply:implementer"
      ],
      "success_transition": "review"
    },
    {
      "state": "review",
      "assignee": "prism/apply/reviewer",
      "aliases": [
        "prism:apply:reviewer"
      ],
      "success_transition": "close",
      "failure_transition": "implementation"
    }
  ]
}
