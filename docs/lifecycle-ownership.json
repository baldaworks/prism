{
  "version": 22,
  "interfaces": {
    "router": {
      "codex": "$prism:lifecycle",
      "claude": "/prism:lifecycle",
      "flat": "/prism-lifecycle"
    },
    "story": {
      "codex": "$prism:story",
      "claude": "/prism:story",
      "flat": "/prism-story"
    },
    "epic": {
      "codex": "$prism:epic",
      "claude": "/prism:epic",
      "flat": "/prism-epic"
    }
  },
  "beads": {
    "membership_label": "prism",
    "approval_label": "human:approved",
    "story_phases": [
      "phase:story:specify",
      "phase:story:design",
      "phase:story:breakdown",
      "phase:story:human",
      "phase:story:apply",
      "phase:story:verify"
    ],
    "epic_phases": [
      "phase:epic:frame",
      "phase:epic:architecture",
      "phase:epic:roadmap",
      "phase:epic:approval",
      "phase:epic:delivery",
      "phase:epic:validation"
    ],
    "unsupported_phase_policy": "treat-as-absent-no-migration",
    "missing_phase_initialization": {
      "story": "phase:story:specify",
      "epic": "phase:epic:frame",
      "clear_approval": true
    },
    "hierarchy": {
      "epic_children": "story",
      "story_children": "task",
      "nested_epics": false,
      "direct_epic_tasks": false
    }
  },
  "routing": {
    "priority": [
      "explicit-open-epic-batch",
      "explicit-story-or-epic-id",
      "task-parent-story",
      "unambiguous-single-item-resume",
      "clear-multi-story-intent",
      "ordinary-story-intent"
    ],
    "open_epic_batch": {
      "selection": "one invocation-start snapshot of open epic items labeled prism",
      "order": [
        "priority",
        "created_at",
        "id"
      ],
      "visit": "exactly-once-sequential",
      "continue_after_item_local_stop": true,
      "rescan": false,
      "approval_transfer": false,
      "empty_snapshot": "report-and-create-nothing",
      "output": "one-outcome-row-per-snapshot-id"
    }
  },
  "approval": {
    "host_story_order": [
      "Design summary",
      "Task summary",
      "Approval request"
    ],
    "host_epic_order": [
      "Architecture summary",
      "Story roadmap",
      "Approval request"
    ],
    "host_acceptance_output": "explicit-request-only-complete-untruncated-current-item-only",
    "missing_acceptance": {
      "story": "phase:story:specify",
      "epic": "phase:epic:frame"
    },
    "epic_approval_cascades_to_stories": false
  },
  "child_graph": {
    "numeric_minimum": null,
    "numeric_maximum": null,
    "quality": [
      "coverage",
      "cohesion",
      "reviewability",
      "verifiability",
      "necessary-acyclic-dependencies"
    ],
    "one_child_can_pass": true,
    "more_than_twelve_can_pass": true,
    "incomplete_graph_fails": true,
    "separable_mega_item_fails": true
  },
  "surface_ownership": {
    "router": {
      "canonical": "plugins/prism/skills/lifecycle",
      "flat": "plugins/prism/prefixed-skills/prism-lifecycle",
      "owns": [
        "target-resolution",
        "open-epic-batch-coordination"
      ]
    },
    "story": {
      "canonical": "plugins/prism/skills/story",
      "flat": "plugins/prism/prefixed-skills/prism-story",
      "owns": [
        "specify",
        "design",
        "breakdown",
        "human",
        "apply",
        "verify"
      ]
    },
    "epic": {
      "canonical": "plugins/prism/skills/epic",
      "flat": "plugins/prism/prefixed-skills/prism-epic",
      "owns": [
        "frame",
        "architecture",
        "roadmap",
        "approval",
        "delivery",
        "validation"
      ]
    }
  },
  "task_states": [
    {
      "state": "implementing",
      "assignee": "prism/apply/implementer"
    },
    {
      "state": "reviewing",
      "assignee": "prism/apply/reviewer"
    }
  ],
  "delivery_evidence": {
    "storage": "story-notes-append-only",
    "fields": [
      "repository",
      "base",
      "artifact",
      "state",
      "merge_commit",
      "checks",
      "verified_at"
    ],
    "allowed_terminal_states": [
      "MERGED",
      "NO_CHANGE"
    ],
    "refresh": "independent-forge-and-git-verification",
    "unmerged_policy": "remain-in-story-verify",
    "close_reason": "Verified; delivery=<repo:PR|NO_CHANGE@merge_sha>; ci=<required checks>; verify=acceptance met, no findings"
  },
  "scope_revision": {
    "marker": "SCOPE_REVISION",
    "material_action": "route-earliest-affected-phase-and-renew-human-approval",
    "implementation_detail_action": "record-rationale-and-continue-apply",
    "preserve_completed_children": true
  },
  "integrity": {
    "aggregate_algorithm": "sha256 over sorted source path UTF-8, NUL, file bytes, NUL",
